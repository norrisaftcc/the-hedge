diff --git a/kaiju/tests/unravel.test.mjs b/kaiju/tests/unravel.test.mjs
new file mode 100644
index 0000000..a3e8bca
--- /dev/null
+++ b/kaiju/tests/unravel.test.mjs
@@ -0,0 +1,85 @@
+// KAI-12 (issue #24, DESIGN 18.3), the unravel and reform experiment: a part other than the body
+// brought to 0 unravels; it reforms at half its hit points, rounded up, after RULES.reformTurns of
+// the monster's phases, for RULES.reformEnergy energy. Regen does not heal it.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { create, step } from "../src/rules.js";
+import { RULES } from "../src/data/kaiju.js";
+import { blank, putUnit, at, setup } from "./fixtures.mjs";
+
+const endTurn = (s) => step(s, { t: "end" });
+
+test("the Squamous One and its variant carry the unravel passive; the other three do not", () => {
+  for (const [kaiju, variant, want] of [["squamous", null, true], ["squamous", "meowthprrtep", true], ["radiosaur", null, false], ["thalassor", null, false], ["dairengo", null, false]]) {
+    const s = create(setup(blank(), { kaiju, variant, mutations: variant ? undefined : [] }));
+    assert.equal(s.kaiju.passives.includes("unravel"), want, `${kaiju}:${variant}`);
+    assert.deepEqual(s.kaiju.unravelled, {});
+  }
+});
+
+test("a hit that brings a part to 0 unravels it, and a part that is already gone sends hits to the body", () => {
+  const s = create(setup(blank(), { kaiju: "squamous", mutations: [] }));
+  for (const p of ["head", "arms", "legs", "aux"]) s.kaiju.parts[p].hp = 1;
+  s.kaiju.energy = 0;
+  for (let i = 0; i < 6; i++) putUnit(s, "artillery", at(5 + (i % 3), 3 + Math.floor(i / 3)));
+  const { events, state } = endTurn(s);
+  const un = events.filter((e) => e.k === "unravel");
+  assert.ok(un.length > 0, "something unravelled");
+  for (const e of un) {
+    assert.equal(Object.hasOwn(state.kaiju.unravelled, e.part), true);
+    assert.equal(state.kaiju.parts[e.part].hp, 0);
+    assert.ok(e.text.length > 0);
+  }
+  assert.ok(!events.some((e) => e.k === "part" && e.state === "crippled" && e.who === "squamous" && e.part !== "body"));
+});
+
+test("reform: after reformTurns phases, with energy, at ceil(max/2); regen never heals it", () => {
+  let s = create(setup(blank(), { kaiju: "squamous", mutations: [] }));
+  s.kaiju.parts.arms.hp = 0;
+  s.kaiju.unravelled.arms = 0;
+  s.kaiju.parts.body.hp -= 3; // regen has something else to heal
+  s.kaiju.energy = RULES.reformEnergy + 1;
+  let out = endTurn(s);
+  assert.equal(out.state.kaiju.parts.arms.hp, 0, "one phase: not yet");
+  assert.equal(out.events.filter((e) => e.k === "heal").every((e) => e.part !== "arms"), true);
+  out = endTurn(out.state);
+  const re = out.events.find((e) => e.k === "reform");
+  assert.ok(re, "second phase: reform");
+  assert.equal(re.hp, Math.ceil(s.kaiju.parts.arms.max / 2));
+  // Regen runs after the reform in the same phase and may add one to the worst part.
+  assert.ok([re.hp, re.hp + RULES.heal].includes(out.state.kaiju.parts.arms.hp));
+  assert.equal(Object.hasOwn(out.state.kaiju.unravelled, "arms"), false);
+  assert.equal(out.state.kaiju.energy, 1);
+  assert.ok(re.text.length > 0);
+});
+
+test("reform waits for energy and then goes the phase it has it", () => {
+  let s = create(setup(blank(), { kaiju: "squamous", variant: "meowthprrtep", mutations: undefined }));
+  s.kaiju.parts.head.hp = 0;
+  s.kaiju.unravelled.head = 0;
+  s.kaiju.energy = RULES.reformEnergy - 1;
+  let out = endTurn(s);
+  out = endTurn(out.state);
+  out = endTurn(out.state);
+  assert.equal(out.state.kaiju.parts.head.hp, 0);
+  assert.equal(out.events.some((e) => e.k === "reform"), false);
+  out.state.kaiju.energy = RULES.reformEnergy;
+  out = endTurn(out.state);
+  const re = out.events.find((e) => e.k === "reform");
+  assert.equal(re.hp, Math.ceil(out.state.kaiju.parts.head.max / 2));
+  assert.equal(out.state.kaiju.energy, 0);
+});
+
+test("the same state and the same commands give the same events", () => {
+  const make = () => {
+    const s = create(setup(blank(), { kaiju: "squamous", mutations: [] }));
+    s.kaiju.parts.arms.hp = 0;
+    s.kaiju.unravelled.arms = 1;
+    s.kaiju.energy = 5;
+    return s;
+  };
+  const a = endTurn(make());
+  const b = endTurn(make());
+  assert.deepEqual(a.events, b.events);
+  assert.deepEqual(a.state, b.state);
+});
