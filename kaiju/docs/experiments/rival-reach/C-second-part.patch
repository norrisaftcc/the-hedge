diff --git a/kaiju/tests/reach.test.mjs b/kaiju/tests/reach.test.mjs
new file mode 100644
index 0000000..0c27eb5
--- /dev/null
+++ b/kaiju/tests/reach.test.mjs
@@ -0,0 +1,43 @@
+// KAI-11 (DESIGN §17.2, issue #27): a living monster can always hurt an adjacent rival kaiju.
+// For every kaiju and every look, with any one of head, arms, legs or aux crippled, the
+// once-a-mission attacks spent, full AP and energy, and the rival in each of the six adjacent
+// hexes, canHurtRival is true.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import * as H from "../src/hex.js";
+import { create } from "../src/rules.js";
+import { KAIJU } from "../src/data/kaiju.js";
+import { LOOKS, kaijuDef } from "../src/data/variants.js";
+import { canHurtRival } from "../tools/sim.mjs";
+import { blank, setup } from "./fixtures.mjs";
+
+const CRIPPLE = ["none", "head", "arms", "legs", "aux"];
+
+// Every (kaiju, look) pair the game offers: the base look is variant null.
+const looks = Object.keys(KAIJU).flatMap((id) => LOOKS[id].map((look) => ({ id, variant: look === id ? null : look })));
+
+// The cases that fail, as strings: "<kaiju>[:<look>] crippled <part> rival <dir>".
+function failures() {
+  const out = [];
+  for (const { id, variant } of looks) {
+    const rivalId = id === "squamous" ? "radiosaur" : "squamous";
+    for (const part of CRIPPLE) {
+      for (let dir = 0; dir < 6; dir++) {
+        const m = blank({ objective: { kind: "rival" }, rivalStart: { at: [5, 0], facing: 3 }, rivalRetreat: [] });
+        const s = create(setup(m, { kaiju: id, variant, mutations: variant ? null : [], rival: rivalId }));
+        s.rival.at = H.neighbor(s.kaiju.at, dir);
+        if (part !== "none") s.kaiju.parts[part].hp = 0;
+        for (const a of kaijuDef(id, variant).attacks) if (a.effects.oncePerMission) s.kaiju.used[a.id] = true;
+        if (!canHurtRival(s, { fresh: true })) out.push(`${id}${variant ? ":" + variant : ""} crippled ${part} rival dir ${dir}`);
+      }
+    }
+  }
+  return out;
+}
+
+test("KAI-11: every kaiju and look can hurt an adjacent rival with any one part crippled", () => {
+  assert.equal(looks.length, 8, "four kaiju, two looks each");
+  const bad = failures();
+  if (process.env.REACH_LIST) console.log(`failing cases: ${bad.length} of ${looks.length * CRIPPLE.length * 6}\n${bad.join("\n")}`);
+  assert.deepEqual(bad, [], `${bad.length} failing cases, first: ${bad.slice(0, 3).join("; ")}`);
+});
